# JobSPA 环境变量配置示例
# 复制此文件为 .env 并修改配置

# Flask 配置
FLASK_ENV=production
SECRET_KEY=your_secret_key_change_me_in_production

# 数据库配置
# SQLite (默认)
DATABASE_URL=sqlite:////app/data/projectmanagement.db

# 如果使用其他数据库，请取消注释并修改
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/jobspa
# MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/jobspa

# 文件上传配置
UPLOAD_FOLDER=/app/uploads

# AI 配置 (可选 - 用于工作日志生成)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
